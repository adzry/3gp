{
  "name": "3gp",
  "version": "0.1.0",
  "description": "A personal AI-assisted video production laboratory built on Remotion.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "compositions": "remotion compositions",
    "new": "node tools/new-project.mjs",
    "validate": "node tools/validate.mjs",
    "render": "node tools/render.mjs",
    "stills": "node tools/render.mjs --stills",
    "captions:srt": "node tools/captions/srt-to-json.mjs",
    "media": "node tools/media/media.mjs",
    "music": "node tools/audio/music.mjs",
    "transcribe": "node tools/captions/transcribe.mjs",
    "transcript": "node tools/captions/transcript.mjs",
    "fixtures": "node tools/render.mjs fixture-footage --out public/fixtures/placeholder-footage.mp4",
    "typecheck": "tsc",
    "check": "eslint src projects && tsc && node --test \"tests/*.test.mjs\" && node tools/validate.mjs",
    "skills": "npx -y skills add remotion-dev/skills -a claude-code -s '*' -y --copy",
    "setup": "bash tools/setup.sh",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/captions": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/media": "4.0.529",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.529",
    "@remotion/install-whisper-cpp": "4.0.529",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
