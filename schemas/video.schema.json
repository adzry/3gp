{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "fps": {
      "default": 30,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "format": {
      "default": "landscape",
      "type": "string",
      "enum": [
        "landscape",
        "vertical",
        "square"
      ]
    },
    "theme": {
      "default": "studio",
      "type": "string",
      "enum": [
        "studio",
        "vox-editorial"
      ]
    },
    "audio": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "volume": {
          "default": 1,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "src"
      ]
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "template": {
                "type": "string",
                "const": "TitleCard"
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "name": {
                "type": "string"
              },
              "theme": {
                "type": "string",
                "enum": [
                  "studio",
                  "vox-editorial"
                ]
              },
              "props": {
                "type": "object",
                "properties": {
                  "kicker": {
                    "description": "Small label above the title.",
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "subtitle": {
                    "type": "string"
                  },
                  "emphasis": {
                    "default": [],
                    "description": "Words/phrases that get the theme's emphasis device. One per scene is best.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "align": {
                    "default": "left",
                    "type": "string",
                    "enum": [
                      "left",
                      "center"
                    ]
                  }
                },
                "required": [
                  "title"
                ]
              }
            },
            "required": [
              "template",
              "seconds",
              "props"
            ]
          },
          {
            "type": "object",
            "properties": {
              "template": {
                "type": "string",
                "const": "KineticText"
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "name": {
                "type": "string"
              },
              "theme": {
                "type": "string",
                "enum": [
                  "studio",
                  "vox-editorial"
                ]
              },
              "props": {
                "type": "object",
                "properties": {
                  "lines": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Shown one after another, evenly across the scene."
                  },
                  "emphasis": {
                    "default": [],
                    "description": "Words/phrases that get the theme's emphasis device. One per scene is best.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "size": {
                    "default": 150,
                    "type": "number"
                  }
                },
                "required": [
                  "lines"
                ]
              }
            },
            "required": [
              "template",
              "seconds",
              "props"
            ]
          },
          {
            "type": "object",
            "properties": {
              "template": {
                "type": "string",
                "const": "LowerThird"
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "name": {
                "type": "string"
              },
              "theme": {
                "type": "string",
                "enum": [
                  "studio",
                  "vox-editorial"
                ]
              },
              "props": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "side": {
                    "default": "left",
                    "type": "string",
                    "enum": [
                      "left",
                      "right"
                    ]
                  },
                  "background": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "template",
              "seconds",
              "props"
            ]
          },
          {
            "type": "object",
            "properties": {
              "template": {
                "type": "string",
                "const": "QuoteCard"
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "name": {
                "type": "string"
              },
              "theme": {
                "type": "string",
                "enum": [
                  "studio",
                  "vox-editorial"
                ]
              },
              "props": {
                "type": "object",
                "properties": {
                  "quote": {
                    "type": "string"
                  },
                  "author": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "emphasis": {
                    "default": [],
                    "description": "Words/phrases that get the theme's emphasis device. One per scene is best.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "quote",
                  "author"
                ]
              }
            },
            "required": [
              "template",
              "seconds",
              "props"
            ]
          },
          {
            "type": "object",
            "properties": {
              "template": {
                "type": "string",
                "const": "MetricCard"
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "name": {
                "type": "string"
              },
              "theme": {
                "type": "string",
                "enum": [
                  "studio",
                  "vox-editorial"
                ]
              },
              "props": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  },
                  "prefix": {
                    "default": "",
                    "type": "string"
                  },
                  "suffix": {
                    "default": "",
                    "type": "string"
                  },
                  "decimals": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "context": {
                    "description": "One line that explains the number.",
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "annotate": {
                    "default": false,
                    "description": "Draw a hand circle around the number.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            },
            "required": [
              "template",
              "seconds",
              "props"
            ]
          },
          {
            "type": "object",
            "properties": {
              "template": {
                "type": "string",
                "const": "BarChart"
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "name": {
                "type": "string"
              },
              "theme": {
                "type": "string",
                "enum": [
                  "studio",
                  "vox-editorial"
                ]
              },
              "props": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "unit": {
                    "default": "",
                    "type": "string"
                  },
                  "data": {
                    "minItems": 1,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        },
                        "highlight": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "label",
                        "value"
                      ]
                    }
                  },
                  "annotation": {
                    "description": "Hand-written note on the highlighted bar.",
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "data"
                ]
              }
            },
            "required": [
              "template",
              "seconds",
              "props"
            ]
          },
          {
            "type": "object",
            "properties": {
              "template": {
                "type": "string",
                "const": "CaptionedShort"
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "name": {
                "type": "string"
              },
              "theme": {
                "type": "string",
                "enum": [
                  "studio",
                  "vox-editorial"
                ]
              },
              "props": {
                "type": "object",
                "properties": {
                  "headline": {
                    "type": "string"
                  },
                  "background": {
                    "type": "string"
                  },
                  "captions": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "startMs": {
                          "type": "number"
                        },
                        "endMs": {
                          "type": "number"
                        },
                        "timestampMs": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "confidence": {
                          "type": [
                            "number",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "text",
                        "startMs",
                        "endMs",
                        "timestampMs",
                        "confidence"
                      ]
                    }
                  },
                  "captionsFile": {
                    "type": "string"
                  },
                  "audio": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "template",
              "seconds",
              "props"
            ]
          },
          {
            "type": "object",
            "properties": {
              "template": {
                "type": "string",
                "const": "LogoReveal"
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "name": {
                "type": "string"
              },
              "theme": {
                "type": "string",
                "enum": [
                  "studio",
                  "vox-editorial"
                ]
              },
              "props": {
                "type": "object",
                "properties": {
                  "wordmark": {
                    "type": "string"
                  },
                  "tagline": {
                    "type": "string"
                  },
                  "logo": {
                    "type": "string"
                  }
                },
                "required": [
                  "wordmark"
                ]
              }
            },
            "required": [
              "template",
              "seconds",
              "props"
            ]
          }
        ]
      }
    },
    "$schema": {
      "type": "string"
    },
    "variants": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]+$"
          },
          "format": {
            "type": "string",
            "enum": [
              "landscape",
              "vertical",
              "square"
            ]
          },
          "theme": {
            "type": "string",
            "enum": [
              "studio",
              "vox-editorial"
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    }
  },
  "required": [
    "id",
    "title",
    "scenes"
  ]
}
